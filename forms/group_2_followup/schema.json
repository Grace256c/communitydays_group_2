{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "condition": {
      "type": "string",
      "enum": [
        "Thriving",
        "Needs water",
        "Pest damage"
      ],
      "title": "Crop condition"
    },
    "harvest": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "title": "Harvest in kilograms"
    },
    "notes": {
      "type": "string",
      "title": "Visit notes",
      "minLength": 1,
      "maxLength": 240
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "entity_id",
    "condition",
    "harvest",
    "notes"
  ]
}
